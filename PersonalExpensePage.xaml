<Page x:Class="SplitHive.PersonalExpensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Personal Expenses">

    <!-- Gradient Background -->
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEEEEE" Offset="0"/>
            <GradientStop Color="#D8C9A7" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Header with Back -->
            <DockPanel Margin="0,0,0,20">
                <!-- Back Button -->
                <Button x:Name="btnBack" Width="36" Height="36" Click="Back_Click" DockPanel.Dock="Left" Background="White" BorderThickness="0">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                    </Button.Effect>
                    <Path Data="M10,0 L0,10 L10,20" Stroke="#24324D" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
                <!-- Header Text -->
                <TextBlock Text="Personal Expenses" FontSize="40" FontWeight="ExtraBold" Foreground="#5C6F2B" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Script MT Bold"/>
            </DockPanel>

            <!-- Main Card -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20" >
                <StackPanel>

                    <!-- Monthly Budget Section -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="chkEnableBudget" Content="Enable Monthly Budget" FontSize="16" Foreground="#5C6F2B" Margin="0,0,10,0"/>
                            <Border Background="#F8F9FA" BorderBrush="#D8C9A7" BorderThickness="1" CornerRadius="6">
                                <TextBox x:Name="txtBudget" Width="220" Height="32" IsEnabled="False" Padding="6" BorderThickness="0"/>
                            </Border>
                            <Button Content="Save Budget" Width="130" Height="32" Background="#DE802B" Foreground="White" FontWeight="Bold" Click="SaveBudget_Click" Margin="10,0,0,0">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="txtAlert" FontSize="16" FontWeight="Bold" Margin="0,10,0,0" Foreground="#DE802B"/>
                    </StackPanel>

                    <!-- Add Expense Section -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Add New Expense" FontSize="20" FontWeight="SemiBold" Foreground="#5C6F2B" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Amount -->
                            <TextBlock Text="Amount:" Grid.Row="0" Grid.Column="0" FontSize="16" Foreground="#5C6F2B" VerticalAlignment="Center"/>
                            <Border Background="#F8F9FA" BorderBrush="#D8C9A7" BorderThickness="1" CornerRadius="6" Grid.Row="0" Grid.Column="1">
                                <TextBox x:Name="txtAmount" Height="32" Padding="6" BorderThickness="0"/>
                            </Border>

                            <!-- Category -->
                            <TextBlock Text="Category:" Grid.Row="1" Grid.Column="0" FontSize="16" Foreground="#5C6F2B" VerticalAlignment="Center"/>
                            <Border Background="#F8F9FA" BorderBrush="#D8C9A7" BorderThickness="1" CornerRadius="6" Grid.Row="1" Grid.Column="1">
                                <ComboBox x:Name="cmbCategory" Height="32" Padding="4" BorderThickness="0">
                                    <ComboBoxItem Content="Food"/>
                                    <ComboBoxItem Content="Transport"/>
                                    <ComboBoxItem Content="Shopping"/>
                                    <ComboBoxItem Content="Bills"/>
                                    <ComboBoxItem Content="Entertainment"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="Description:" Grid.Row="2" Grid.Column="0" FontSize="16" Foreground="#5C6F2B" VerticalAlignment="Top" Margin="0,4,0,4"/>
                            <Border Background="#F8F9FA" BorderBrush="#D8C9A7" BorderThickness="1" CornerRadius="6" Grid.Row="2" Grid.Column="1">
                                <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" Padding="6" BorderThickness="0"/>
                            </Border>

                            <!-- Date -->
                            <TextBlock Text="Date:" Grid.Row="3" Grid.Column="0" FontSize="16" Foreground="#5C6F2B" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpExpenseDate" Grid.Row="3" Grid.Column="1" Height="32"/>

                            <!-- Add Expense Button -->
                            <Button Content="Add Expense" Grid.Row="4" Grid.Column="1" Width="150" Height="34" Margin="0,12,0,0" HorizontalAlignment="Left" Background="#DE802B" Foreground="White" FontWeight="Bold" Click="AddExpense_Click">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Expense History Button -->
                    <Button Content="View Expense History" Width="220" Height="36" Background="#5C6F2B" Foreground="White" FontWeight="Bold" Click="ViewHistory_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
