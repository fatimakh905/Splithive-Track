<Page x:Class="SplitHive.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginPage">

    <Grid>
        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#667eea" Offset="0"/>
                <GradientStop Color="#764ba2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Center Card -->
        <Border Width="896" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"
        CornerRadius="20" Padding="40">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>

                <!-- App Title -->
                <TextBlock Text="SplitHive Track" FontSize="72" Foreground="#FF542D7C" 
                           HorizontalAlignment="Center" Margin="0,0,0,15" FontFamily="Script MT Bold"/>

                <TextBlock Text="Login to your account" FontSize="22" FontWeight="SemiBold" 
                           Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Email -->
                <TextBlock Text="Email:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="52" Margin="0,0,0,15" FontSize="16" VerticalContentAlignment="Center"
                         Background="#f5f5f5" BorderBrush="#ccc" BorderThickness="1" Padding="12"/>

                <!-- Password -->
                <TextBlock Text="Password:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="52" Margin="0,0,0,20" FontSize="16" VerticalContentAlignment="Center"
                             Background="#f5f5f5" BorderBrush="#ccc" BorderThickness="1" Padding="12"/>

                <!-- Login Button -->
                <Button Content="Login" Click="Login_Click" Height="60" Background="#FF283B90" Foreground="#FFE08AC5"
                        FontWeight="Bold" Margin="0,0,0,20" BorderThickness="3" FontSize="20" Cursor="Hand" BorderBrush="#FF5659CB">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#667eea"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFB2B8EE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Signup navigation -->
                <Button Content="Create an Account" Click="GoToSignup_Click" Height="55" 
                        Foreground="#FFE08AC5" FontWeight="Bold" BorderThickness="2" FontSize="18" Cursor="Hand" BorderBrush="#FF5659CB">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FF6160AC" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>
