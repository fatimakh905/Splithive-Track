<Page x:Class="SplitHive.GroupListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="GroupListPage">

    <!-- Gradient Background -->
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEEEEE" Offset="0"/>
            <GradientStop Color="#D8C9A7" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid>

        <!-- BACK BUTTON -->
        <Button x:Name="btnBack" Width="40" Height="40" Click="Back_Click" Margin="10"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" BorderThickness="0" FontFamily="Script MT Bold">
            <Button.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
            </Button.Effect>
            <Path Data="M10,0 L0,10 L10,20" Stroke="#24324D" StrokeThickness="2" Stretch="Uniform"/>
        </Button>

        <!-- Page Title -->
        <TextBlock Text="Groups" FontSize="36" FontWeight="ExtraBold" Foreground="#5C6F2B"
                   HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="Script MT Bold"/>

        <!-- Groups DataGrid -->
        <DataGrid x:Name="dgGroups" AutoGenerateColumns="False" Margin="30,80,30,100" Background="White"
                  Foreground="#24324D" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"
                  RowBackground="#F6F7FB" AlternatingRowBackground="#ECEFF6"
                  MouseDoubleClick="dgGroups_MouseDoubleClick" FontSize="16">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="Auto"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Group Name" Binding="{Binding GroupName}" Width="*"/>

                <!-- Description -->
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Members -->
                <DataGridTextColumn Header="Members" Binding="{Binding Members}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="#5C6F2B"/>
                    <Setter Property="Background" Value="#D8C9A7"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" >
            <Button Content="Add Group" Width="140" Height="40" Background="#5C6F2B" Foreground="White"
                    Click="ShowAddGroupPanel_Click" FontWeight="SemiBold" Margin="0,0,15,0">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                </Button.Effect>
            </Button>
            <Button Content="Delete Selected" Width="160" Height="40" Background="#DE802B" Foreground="White"
                    Click="DeleteSelected_Click" FontWeight="SemiBold">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                </Button.Effect>
            </Button>
        </StackPanel>

        <!-- Pop-up Add Group Panel -->
        <Border x:Name="AddGroupPanel" Background="White" CornerRadius="12" BorderBrush="#5C6F2B" BorderThickness="2"
                Width="450" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="100">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock Text="Create New Group" FontSize="22" FontWeight="SemiBold" Foreground="#5C6F2B" Margin="0,0,0,15"/>

                    <TextBlock Text="Group Name:" Foreground="#24324D"/>
                    <TextBox x:Name="txtNewGroupName" Height="35" FontSize="16" Margin="0,0,0,10"/>

                    <TextBlock Text="Description (Optional):" Foreground="#24324D"/>
                    <TextBox x:Name="txtNewGroupDesc" Height="80" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,10"/>

                    <TextBlock Text="Members (Comma separated):" Foreground="#24324D"/>
                    <TextBox x:Name="txtNewGroupMembers" Height="80" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Width="90" Height="35" Margin="0,0,15,0" Click="HideAddGroupPanel_Click"/>
                        <Button Content="Save" Width="90" Height="35" Background="#5C6F2B" Foreground="White" Click="AddGroup_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>
