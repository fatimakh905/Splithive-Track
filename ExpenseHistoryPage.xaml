<Page x:Class="SplitHive.ExpenseHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Expense History">

    <!-- Gradient Background -->
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEEEEE" Offset="0"/>
            <GradientStop Color="#D8C9A7" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Header with Back -->
            <DockPanel Margin="0,0,0,20">
                <!-- Back Button -->
                <Button x:Name="btnBack" Width="36" Height="36" Click="Back_Click" DockPanel.Dock="Left" Background="White" BorderThickness="0">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                    </Button.Effect>
                    <Path Data="M10,0 L0,10 L10,20" Stroke="#24324D" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
                <!-- Header Text -->
                <TextBlock Text="Expense History" FontSize="40" FontWeight="ExtraBold" Foreground="#5C6F2B" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Script MT Bold"/>
            </DockPanel>

            <!-- Main Card -->
            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel>

                    <!-- Filters -->
                    <WrapPanel Margin="0,0,0,15">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="From" Foreground="#5C6F2B" FontWeight="SemiBold"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Height="30" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="To" Foreground="#5C6F2B" FontWeight="SemiBold"/>
                            <DatePicker x:Name="dpToDate" Width="140" Height="30" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Category" Foreground="#5C6F2B" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cmbFilterCategory" Width="140" Height="30" Margin="0,2,0,0">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Food"/>
                                <ComboBoxItem Content="Transport"/>
                                <ComboBoxItem Content="Shopping"/>
                                <ComboBoxItem Content="Bills"/>
                                <ComboBoxItem Content="Entertainment"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Sort Amount" Foreground="#5C6F2B" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cmbSortAmount" Width="140" Height="30" Margin="0,2,0,0">
                                <ComboBoxItem Content="None" IsSelected="True"/>
                                <ComboBoxItem Content="Low → High"/>
                                <ComboBoxItem Content="High → Low"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="Apply" Width="100" Height="32" Margin="0,10,0,0" Background="#DE802B" Foreground="White" FontWeight="Bold" Click="ApplyFilter_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="dgExpenses" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,15"
          RowBackground="#F6F7FB" AlternatingRowBackground="#ECEFF6" Foreground="#24324D" GridLinesVisibility="None">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="Auto"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>

                            <!-- Description with TextWrapping -->
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/>
                        </DataGrid.Columns>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="#FF08643F"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Background" Value="#FFDFE2C5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>


                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Delete Selected" Width="140" Height="32" Background="#DE802B" Foreground="White" FontWeight="Bold" Click="DeleteSelected_Click" Margin="0,0,10,0"/>
                        <Button Content="Export to CSV" Width="140" Height="32" Background="#5C6F2B" Foreground="White" FontWeight="Bold" Click="ExportToExcel_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
