<Page x:Class="SplitHive.GroupSettlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="GroupSettlePage">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0F2F5" Offset="0"/>
            <GradientStop Color="#D8C9A7" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,20">

                <!-- Header -->
                <DockPanel Margin="0,0,0,20">
                    <Button x:Name="btnBackSettle" Width="36" Height="36" Click="BackSettle_Click"
                            Background="White" BorderThickness="0"  FontSize="40" FontFamily="Script MT Bold">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                        </Button.Effect>
                        <Path Data="M10,0 L0,10 L10,20" Stroke="#24324D" StrokeThickness="2" Stretch="Uniform"/>
                    </Button>
                    <TextBlock x:Name="txtGroupTitleSettle" FontSize="40" FontWeight="Bold" Foreground="#5C6F2B"
                               HorizontalAlignment="Center" Margin="10,0,0,0" FontFamily="Script MT Bold"/>
                </DockPanel>

                <!-- Settlements Section -->
                <GroupBox Header="Settlements" FontWeight="Bold" FontSize="22" Foreground="#5C6F2B"
                          Background="White" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <DataGrid x:Name="dgSettlementsSettle"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowBackground="#F6F7FB"
                                  AlternatingRowBackground="#ECEFF6"
                                  GridLinesVisibility="None"
                                  Foreground="#24324D" FontSize="18.5" FontWeight="Normal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="From" Binding="{Binding FromMember}" Width="*"/>
                                <DataGridTextColumn Header="To" Binding="{Binding ToMember}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/>
                                <DataGridTemplateColumn Header="Action" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Settle" Tag="{Binding SettlementId}" Width="70"
                                                    Background="#5C6F2B" Foreground="White" Click="SettleSettle_Click" FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Foreground" Value="#5C6F2B"/>
                                    <Setter Property="Background" Value="#D8C9A7"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <Button Content="Export Settlements" Width="160" Height="30" HorizontalAlignment="Right"
                                Margin="0,10,0,0" Click="ExportSettlementsSettle_Click"
                                Background="#5C6F2B" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </GroupBox>

                <!-- Add Expense Button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Add Expense" Width="140" Height="36" Background="#5C6F2B" Foreground="White"
                            FontWeight="SemiBold" FontSize="14" Click="ShowAddExpensePanelSettle_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <!-- Expense History Section -->
                <GroupBox Header="Expense History" FontWeight="Bold" FontSize="22" Foreground="#5C6F2B"
                          Background="White" Padding="10" Margin="0,0,0,20">
                    <StackPanel>

                        <!-- Filters -->
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="From:" VerticalAlignment="Center" Foreground="#FF377239" FontSize="12"/>
                            <DatePicker x:Name="dpFromDateSettle" Width="104" Margin="5,0" FontSize="12"/>
                            <TextBlock Text="To:" VerticalAlignment="Center" Foreground="#FF377239" FontSize="12"/>
                            <DatePicker x:Name="dpToDateSettle" Width="120" Margin="5,0" FontSize="12"/>
                            <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="#FF377239" FontSize="12"/>
                            <ComboBox x:Name="cmbFilterCategorySettle" Width="120" Margin="5,0" FontSize="12">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Food"/>
                                <ComboBoxItem Content="Travel"/>
                                <ComboBoxItem Content="Shopping"/>
                                <ComboBoxItem Content="Bills"/>
                                <ComboBoxItem Content="Entertainment"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                            <Button Content="Apply Filter" Width="90" Margin="10,0,0,0"
                                    Background="#5C6F2B" Foreground="White" FontSize="13" FontWeight="DemiBold"
                                    Click="ApplyFilterSettle_Click"/>
                        </WrapPanel>

                        <!-- Expense DataGrid -->
                        <DataGrid x:Name="dgExpensesSettle"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowBackground="#F6F7FB"
                                  AlternatingRowBackground="#ECEFF6"
                                  GridLinesVisibility="None"
                                  Foreground="#24324D"
                                  Margin="0,0,0,10" FontSize="18.5" FontWeight="Normal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/>
                                <DataGridTextColumn Header="Paid By" Binding="{Binding PaidBy}" Width="*"/>
                                <DataGridTemplateColumn Header="Action" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete" Width="60" Background="#DE802B" Foreground="White"
                                                    Click="DeleteSelectedSettle_Click" FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Foreground" Value="#5C6F2B"/>
                                    <Setter Property="Background" Value="#D8C9A7"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <Button Content="Export Expenses" Width="140" Height="30" HorizontalAlignment="Right"
                                Background="#5C6F2B" Foreground="White" FontWeight="SemiBold"
                                Click="ExportExpensesSettle_Click" FontSize="14"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Add Expense Panel Overlay -->
        <Border x:Name="AddExpensePanelSettle" Background="White" CornerRadius="12" BorderBrush="#5C6F2B"
        BorderThickness="2" Width="450" Height="470" Visibility="Collapsed"
        HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="100">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock Text="Add Group Expense" FontSize="20" FontWeight="SemiBold" Foreground="#5C6F2B" Margin="0,0,0,10"/>

                    <TextBlock Text="Amount:" Foreground="#24324D"/>
                    <TextBox x:Name="txtExpenseAmountSettle" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Category:" Foreground="#24324D"/>
                    <ComboBox x:Name="cmbExpenseCategorySettle" Height="30" Margin="0,0,0,10" FontWeight="Bold">
                        <ComboBoxItem Content="Food"/>
                        <ComboBoxItem Content="Travel"/>
                        <ComboBoxItem Content="Shopping"/>
                        <ComboBoxItem Content="Bills"/>
                        <ComboBoxItem Content="Entertainment"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Text="Paid By:" Foreground="#24324D"/>
                    <ComboBox x:Name="cmbPaidBySettle" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Description:" Foreground="#24324D"/>
                    <TextBox x:Name="txtExpenseDescSettle" Height="60" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="Date:" Foreground="#24324D"/>
                    <DatePicker x:Name="dpExpenseDateSettle" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Participants:" Foreground="#24324D"/>
                    <WrapPanel x:Name="spParticipantsSettle" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="HideAddExpensePanelSettle_Click"/>
                        <Button Content="Add" Width="80" Height="30" Background="#5C6F2B" Foreground="White" Click="AddExpenseSettle_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>
